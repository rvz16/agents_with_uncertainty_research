# W&B local run state and notebook cache — generated at runtime, never commit.
# Only analysis.ipynb, upload_runs.py and SCHEMA.md belong in git here.

# Nested W&B state dir (run-*/ , debug-internal.log, debug.log, latest-run, *.wandb)
wandb/

# Notebook fetch cache (runs.parquet)
.cache/

# Safety nets in case the above are ever produced outside wandb/
debug*.log
*.wandb
