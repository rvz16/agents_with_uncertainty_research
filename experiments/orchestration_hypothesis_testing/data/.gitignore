# Bulky harness artifacts — keep aggregated reports + small metadata only.
spot_check/eval/logs/
spot_check/*/raw_responses/
spot_check/*/predictions*.jsonl
spot_check/*/generation_records.jsonl

# Same rules for spot_check_n50 (and any sibling _probe subtree).
spot_check_n50/eval/logs/
spot_check_n50/_run_logs/
spot_check_n50/*/raw_responses/
spot_check_n50/*/predictions*.jsonl
spot_check_n50/*/generation_records.jsonl
spot_check_n50/_probe/*/raw_responses/
spot_check_n50/_probe/*/predictions*.jsonl
spot_check_n50/_probe/*/generation_records.jsonl

# All calibration / refinement / harness dirs follow the same rule:
# keep aggregated artifacts (likelihood_tables, transition_kernel, policy_comparison,
# cost_summary, sample/run_config, sensitivity, L3_sweep_summary, paper_figs)
# and ignore per-cell bulk (raw_responses, predictions, generation_records,
# iter_records, cost_log, calibration logs, harness logs, eval/logs).
**/raw_responses/
**/iter_raw_responses/
**/predictions*.jsonl
**/generation_records.jsonl
**/critic_results.jsonl
**/critic_results.jsonl.bak_strict
**/critic_results_rescued.jsonl
**/iter_records.jsonl
**/L3_sweep.jsonl
**/cost_log.jsonl
**/calibration*.log
**/calibration*.pid
**/harness*.log
**/eval/logs/
**/eval/eval_logs/

# SWE-Lite source mirror (114MB of raw v1-v3 spot-check artifacts; live on cluster).
swebench_lite/source/
