# === Data policy ===
# Track ONLY:
#   - PAPER_TABLE.{json,csv}            (canonical cube aggregate)
#   - paper_figs/                       (figures embedded in deck/paper)
#   - critic_independence/              (methodology summary)
#   - mde_power/                        (methodology summary)
#   - cluster_bootstrap/                (methodology summary)
#   - fdr_correction/                   (methodology summary)
#   - prior_ci/                         (methodology summary)
#
# Everything else is per-cell experiment output (likelihood_tables,
# transition_kernel, policy_comparison, iter_records, sensitivity, etc.) and
# lives on the cluster + Weights & Biases as artifacts. Use
# scripts/sync_from_cluster.sh to pull locally on demand.

# Per-cell calibration / iter / refinement / sensitivity outputs
**/likelihood_tables*.json
**/transition_kernel*.json
**/policy_comparison*.json
**/iter_records*.jsonl
**/predictions*.jsonl
**/critic_results*.jsonl
**/generation_records*.jsonl
**/L3_sweep*.json*
**/L3_sweep*.csv
**/L3_sweep*.jsonl
**/sensitivity.json
**/sensitivity.csv
**/cost_summary.json
**/cost_log.jsonl
**/RUN_CONFIG.json
**/sample.json
**/stop_distribution.json

# Raw payloads + harness logs (never useful in git)
**/raw_responses/
**/raw_calls/
**/iter_raw_responses/
**/eval/logs/
**/eval/eval_logs/
**/eval_logs/

# Process noise
**/*.log
**/*.pid
**/*.bak
**/.DS_Store

# Per-cell harness eval JSON reports (per-instance pass/fail)
**/eval/*_iter_step*.json
**/eval/*__p[0-9].*.json
**/eval/*_p[0-9].*.json

# Top-level scratch / source dirs that are reproducible from scripts
spot_check/
spot_check_n50/
swebench_lite/source/
**/*_probe/

# Figures: drop bulky regeneratable images; keep canonical CSV summaries
paper_figs/*.png
paper_figs/*.pdf
