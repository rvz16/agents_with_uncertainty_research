# Bulky harness artifacts — keep aggregated reports + small metadata only.
spot_check/eval/logs/
spot_check/*/raw_responses/
spot_check/*/predictions*.jsonl
spot_check/*/generation_records.jsonl

# Same rules for spot_check_n50 (and any sibling _probe subtree).
spot_check_n50/eval/logs/
spot_check_n50/_run_logs/
spot_check_n50/*/raw_responses/
spot_check_n50/*/predictions*.jsonl
spot_check_n50/*/generation_records.jsonl
spot_check_n50/_probe/*/raw_responses/
spot_check_n50/_probe/*/predictions*.jsonl
spot_check_n50/_probe/*/generation_records.jsonl
